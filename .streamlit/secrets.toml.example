# Copy this file to .streamlit/secrets.toml for a local run, or paste the same
# contents into Streamlit Community Cloud's "Secrets" box under Advanced
# settings when deploying. The real file is gitignored and never committed.
#
# Only generation needs the API key: extraction, retrieval, the sources panel
# and the "Not in the filing." refusal all work without one, and the app says
# so plainly when it is missing.

ANTHROPIC_API_KEY = "paste-your-key-here"

# Optional, deployed app only. Opening the app once with ?owner=<this value>
# exempts that session from the public demo's rate limits (ui/limits.py).
# Use a long random value; local runs are never limited and do not need it.
FOLIO_OWNER_KEY = "paste-a-long-random-value-here"

# Optional, deployed app only. Lets the maintainer's "Add a company" panel save
# a new company: a GitHub fine-grained token for this one repository with
# "Contents: Read and write" (that covers commits and release assets) and
# nothing else. Locally the panel uses your gh login instead.
GITHUB_TOKEN = "paste-a-fine-grained-token-here"
