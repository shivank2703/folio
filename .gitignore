# --- Secrets & real data (hard constraint: keys/real data never in git) ---
.env
# the deployed app gets this from Community Cloud's settings box instead
.streamlit/secrets.toml
# v4: real watchlists never committed; only watchlist.sample.yaml ships (SPEC.md §7)
watchlist.yaml

# --- Source filings: not committed; corpus/SOURCES.md lists where to get them (SPEC.md §7) ---
corpus/*.pdf

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Generated artifacts: data/ is tracked as a folder, its contents are not.
# The LanceDB index was committed until v1.1; it now lives as a release asset
# that corpus/index.json names and the app downloads at startup
# (retrieve/store.py), because every rebuild added ~10 MB to git history.
# Earlier commits keep their copy; nothing new is committed. ---
data/*
!data/.gitkeep

# --- OS / editor noise ---
.DS_Store
